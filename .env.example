# Copy to .env and adjust.

# Host port the launchpad listens on. Point cloudflared at this.
LAUNCHPAD_PORT=8080

# How the launchpad container reaches Immich for health checks.
# Same Docker host as Immich: leave as host.docker.internal.
# Immich in a different LXC/VM: use its LAN IP, e.g. http://192.168.1.50:2283
IMMICH_URL=http://host.docker.internal:2283
