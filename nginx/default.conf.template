# Rendered by deploy/install.sh into /etc/nginx/sites-available/launchpad.
# Only ${SITE_ROOT} and ${IMMICH_URL} are substituted; nginx's own $variables
# are left alone.

server {
    listen 80 default_server;
    server_name _;

    root ${SITE_ROOT};
    index index.html;

    add_header X-Content-Type-Options "nosniff" always;
    add_header Referrer-Policy "strict-origin-when-cross-origin" always;

    location / {
        try_files $uri $uri/ /index.html;
    }

    # Edited by hand to add services, so browsers should always revalidate it.
    location = /services.json {
        add_header Cache-Control "no-cache" always;
        add_header X-Content-Type-Options "nosniff" always;
    }

    location ~* \.(css|js|svg|png|ico|woff2?)$ {
        add_header Cache-Control "public, max-age=3600" always;
        add_header X-Content-Type-Options "nosniff" always;
    }

    # ---- Health checks ------------------------------------------------------
    # Each service with a "health" path in services.json gets a block here that
    # proxies to the service on the LAN, bypassing Cloudflare. That way the
    # status dot reflects the service itself, not Cloudflare's edge.

    location = /health/photos {
        proxy_pass ${IMMICH_URL}/api/server/ping;
        proxy_connect_timeout 3s;
        proxy_read_timeout 3s;
        access_log off;
    }

    # Example for the next service:
    # location = /health/jellyfin {
    #     proxy_pass http://192.168.1.20:8096/health;   # Jellyfin LXC's IP
    #     proxy_connect_timeout 3s;
    #     proxy_read_timeout 3s;
    #     access_log off;
    # }
}
